{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "家庭持续阅读接力 领域事件目录",
  "description": "所有事件共享信封 event_id/kind/occurred_at/subject_id/version；每种 kind 的必需载荷字段以 src/events.py 的 PAYLOAD_REQUIRED 为准（由测试保证与本文件 enum 同步）。",
  "type": "object",
  "required": ["event_id", "kind", "occurred_at", "subject_id", "version"],
  "properties": {
    "event_id": {"type": "string"},
    "kind": {
      "type": "string",
      "enum": [
        "READER_REGISTERED",
        "GUARDIANSHIP_DECLARED",
        "CONSENT_GRANTED",
        "CONSENT_WITHDRAWN",
        "BOOK_TITLE_REGISTERED",
        "BOOK_EDITION_PUBLISHED",
        "TITLE_DESCRIPTION_UPDATED",
        "STORE_REGISTERED",
        "STORE_CLOSURE_SCHEDULED",
        "STORE_REOPENED",
        "COPIES_ADDED",
        "LOAN_REQUEST_ACCEPTED",
        "LOAN_IN_TRANSIT",
        "LOAN_READY_FOR_PICKUP",
        "LOAN_PICKED_UP",
        "LOAN_RETURNED",
        "APPOINTMENT_SCHEDULED",
        "APPOINTMENT_RESCHEDULED",
        "APPOINTMENT_FULFILLED",
        "READING_GUIDE_ASSIGNED",
        "RECOMMENDATION_MADE",
        "AUTHOR_EVENT_SCHEDULED",
        "EVENT_REGISTERED",
        "EVENT_WAITLISTED",
        "EVENT_REGISTRATION_CANCELLED",
        "WAITLIST_ENTRY_PROMOTED",
        "EVENT_ATTENDANCE_RECORDED",
        "MEMBERSHIP_GRANTED",
        "BENEFIT_USED",
        "FAMILY_FEEDBACK_RECORDED"
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "subject_id": {"type": "string", "const": "family-reading-continuity"},
    "version": {"type": "integer", "minimum": 1},

    "reader_id": {"type": "string"},
    "family_id": {"type": "string"},
    "guardian_id": {"type": "string"},
    "child_id": {"type": "string"},
    "actor_id": {"type": "string"},
    "display_name": {"type": "string"},
    "birth_date": {"type": "string", "format": "date"},
    "is_minor": {"type": "boolean"},
    "interests": {"type": "array", "items": {"type": "string"}},
    "relationship": {"type": "string"},
    "on_behalf_of_child": {"type": "boolean"},
    "self_withdrawal": {"type": "boolean"},

    "consent_id": {"type": "string"},
    "scope": {
      "type": "string",
      "enum": ["profile", "loan", "recommendation", "guidance", "event", "feedback"]
    },

    "title_id": {"type": "string"},
    "edition_id": {"type": "string"},
    "title": {"type": "string"},
    "author": {"type": "string"},
    "isbn": {"type": "string"},
    "publisher": {"type": "string"},
    "min_age": {"type": "integer", "minimum": 0},
    "max_age": {"type": "integer", "minimum": 0},
    "summary": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "change_note": {"type": "string"},

    "store_id": {"type": "string"},
    "owning_store_id": {"type": "string"},
    "pickup_store_id": {"type": "string"},
    "return_store_id": {"type": "string"},
    "new_store_id": {"type": "string"},
    "city": {"type": "string"},
    "name": {"type": "string"},
    "closure_id": {"type": "string"},
    "starts_at": {"type": "string", "format": "date-time"},
    "ends_at": {"type": "string", "format": "date-time"},
    "reopened_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string"},
    "batch_id": {"type": "string"},
    "quantity": {"type": "integer", "minimum": 1},

    "loan_id": {"type": "string"},
    "request_id": {"type": "string"},
    "at": {"type": "string", "format": "date-time"},
    "due_at": {"type": "string", "format": "date-time"},

    "appointment_id": {"type": "string"},
    "appointment_kind": {"type": "string", "enum": ["pickup", "return"]},
    "scheduled_at": {"type": "string", "format": "date-time"},
    "new_scheduled_at": {"type": "string", "format": "date-time"},

    "guide_id": {"type": "string"},
    "topic": {"type": "string"},
    "assigned_by": {"type": "string"},
    "basis": {
      "type": "string",
      "description": "指导分配只允许非消费依据：兴趣/年龄/活动参与/家庭反馈/家长请求；禁止消费金额。",
      "enum": ["interest", "age_fit", "author_event", "family_feedback", "guardian_request"]
    },

    "recommendation_id": {"type": "string"},
    "title_description_revision": {"type": "integer", "minimum": 1},
    "rationale": {"type": "string"},
    "recommended_by": {"type": "string"},
    "source": {"type": "string"},

    "author_event_id": {"type": "string"},
    "capacity": {"type": "integer", "minimum": 0},
    "registration_id": {"type": "string"},
    "entry_id": {"type": "string"},
    "position": {"type": "integer", "minimum": 1},

    "plan": {"type": "string"},
    "loan_quota": {"type": "integer", "minimum": 0},
    "valid_from": {"type": "string", "format": "date"},
    "valid_until": {"type": "string", "format": "date"},
    "benefit": {
      "type": "string",
      "enum": ["loan", "event_priority", "reading_guide"]
    },
    "ref_id": {"type": "string"},

    "feedback_id": {"type": "string"},
    "rating": {"type": "integer", "minimum": 1, "maximum": 5},
    "note": {"type": "string"}
  },
  "additionalProperties": true
}
